# --- Used by the web app (safe to expose) ---
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=warranty_wallet
VITE_APPWRITE_TABLE_ID=items
VITE_APPWRITE_BUCKET_ID=receipts

# --- Used only by `npm run setup` (keep secret, never commit) ---
# Create in Appwrite Console > Overview > Integrations > API keys
# Scopes needed: databases.read, databases.write, tables.read, tables.write,
# columns.read, columns.write, indexes.read, indexes.write, buckets.read, buckets.write
APPWRITE_API_KEY=your-server-api-key
